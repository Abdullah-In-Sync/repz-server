APP_NAME=Repz
ENVIRONMENT=development
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=repz
POSTGRES_PASSWORD=repz
POSTGRES_DATABASE=repz
DATABASE_URL=
# Neon: paste the pooled connection string as-is. The app converts it for asyncpg
# and uses the direct host for Alembic. Leave POSTGRES_* unused when this is set.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DIRECT_DATABASE_URL=  # optional override for migrations

REDIS_URL=redis://localhost:6379/0
# Production cache: Upstash Redis, e.g. rediss://default:token@xxx.upstash.io:6379

FIREBASE_CREDENTIALS_PATH=./repz-5e06b-firebase-adminsdk-fbsvc-a84a929fb9.json
# On Render, paste the service-account JSON (or its base64) here instead of the file:
# FIREBASE_CREDENTIALS_JSON=

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

MEDIA_ROOT=./media
# Public origin of this API (used in uploaded exercise gif_url). Must not stay localhost in prod.
PUBLIC_BASE_URL=http://localhost:8000
EXERCISES_JSON_PATH=./exercises.json
# Optional: path to exercises-dataset clone for scripts/import_dataset_gifs.py
# EXERCISES_DATASET_ROOT=../exercises-dataset

ADMIN_API_KEY=change-me-admin-key

SENTRY_DSN=
RATE_LIMIT_ENABLED=true
