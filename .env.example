APP_NAME=Repz
ENVIRONMENT=development
DEBUG=true

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=repz
POSTGRES_PASSWORD=repz
POSTGRES_DATABASE=repz
DATABASE_URL=
# Cloud Postgres (Neon, etc.): set DATABASE_URL and leave POSTGRES_* unused.
# Use the pooled host for long-lived API processes. Example:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/repz?sslmode=require

REDIS_URL=redis://localhost:6379/0
# Production cache: Upstash Redis, e.g. rediss://default:token@xxx.upstash.io:6379

FIREBASE_CREDENTIALS_PATH=./repz-5e06b-firebase-adminsdk-fbsvc-a84a929fb9.json

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

MEDIA_ROOT=./media
# Public origin of this API (used in uploaded exercise gif_url). Must not stay localhost in prod.
PUBLIC_BASE_URL=http://localhost:8000
EXERCISES_JSON_PATH=./exercises.json

ADMIN_API_KEY=change-me-admin-key

SENTRY_DSN=
RATE_LIMIT_ENABLED=true
